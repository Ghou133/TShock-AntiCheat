<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable><IsTestProject>true</IsTestProject>
    <TShockBaselineRoot Condition="'$(TShockBaselineRoot)' == ''">$(MSBuildThisFileDirectory)..\..\.lab\runtime-m12-r2\win-x64-framework-dependent</TShockBaselineRoot>
    <!-- The compatibility sources are a read-only external compile input. -->
    <TShockCompatibilityRoot Condition="'$(TShockCompatibilityRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\TShock\compatibility-1.4.5.8-20260910</TShockCompatibilityRoot>
    <OtApiPackageVersion Condition="'$(OtApiPackageVersion)' == ''">3.3.14</OtApiPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\tools\AntiCheat.GameplayScaffold\M6RuntimeDiagnostics.cs" Link="M6RuntimeDiagnostics.cs" />
    <Compile Include="..\..\tools\AntiCheat.GameplayScaffold\M11LiquidStepTrace.cs" Link="M11LiquidStepTrace.cs" />
    <Compile Include="..\..\tools\AntiCheat.NetworkLab\M7TransportDiagnostics.cs" Link="M7TransportDiagnostics.cs" />
    <Compile Include="$(TShockCompatibilityRoot)\src\TerrariaServerAPI\TerrariaServerAPI\TerrariaApi.Server\Hooking\NativeDiagnosticSocketPatch.cs" Link="NativeDiagnosticSocketPatch.cs" />
    <Compile Include="$(TShockCompatibilityRoot)\src\TerrariaServerAPI\TerrariaServerAPI\TerrariaApi.Server\Hooking\NativeLiquidSyncPatch.cs" Link="NativeLiquidSyncPatch.cs" />
    <None Include="..\..\data\progression\candidates.json" Link="data\progression\candidates.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\progression\mklp-operations.json" Link="data\progression\mklp-operations.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\AntiCheat.Plugin.TShock\AntiCheat.Plugin.TShock.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="GetText.NET" Version="8.0.5" />
    <PackageReference Include="MySql.Data" Version="9.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="OTAPI.Upcoming" Version="$(OtApiPackageVersion)" />
    <Reference Include="TShockAPI"><HintPath>$(TShockBaselineRoot)\ServerPlugins\TShockAPI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="TerrariaServer"><HintPath>$(TShockBaselineRoot)\bin\TerrariaServer.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="HttpServer"><HintPath>$(TShockBaselineRoot)\bin\HttpServer.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
